#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

#include "culling.glsl"
#include "scene_types.glsl"

// 워크그룹 하나가 인스턴스 하나를 맡고, 그 인스턴스의 meshlet 을 나누어 검사한다.
layout(local_size_x = 64) in;

layout(push_constant) uniform CullPushConstants {
    InstanceBuffer instances;
    MeshBuffer meshes;
    MeshletBuffer meshlets;
    CameraBuffer camera;
    DrawCommandBuffer drawCommands;
    CounterBuffer drawCounts;
    uint instanceCount;
    uint flags; // bit 0: 절두체, bit 1: 법선 원뿔, bit 2: HZB 오클루전
    uint hzbTexture;
    float hzbMaxLevel;
    vec2 hzbSize;
    LodNetworkBuffer network;
} cull;

#define CULL_FLAG_FRUSTUM 1u
#define CULL_FLAG_CONE 2u
#define CULL_FLAG_OCCLUSION 4u
#define CULL_FLAG_NEURAL_LOD 8u

void main() {
    uint instanceIndex = gl_WorkGroupID.x;
    if (instanceIndex >= cull.instanceCount) {
        return;
    }

    Instance instance = cull.instances.items[instanceIndex];
    Mesh mesh = cull.meshes.items[instance.meshIndex];
    Camera camera = cull.camera.item;

    vec4 planes[5];
    extractFrustumPlanes(camera.viewProjection, planes);

    // 스키닝 인스턴스의 meshlet 경계와 법선 원뿔은 바인드 포즈 기준이라 포즈가 바뀌면 맞지 않는다.
    // 잘못 버려 구멍이 나는 쪽이 더 눈에 띄므로 컬링만 건너뛴다. LOD 선정은 오차 구의 상대 크기만
    // 쓰므로 그대로 두어도 같은 그룹이 같은 판정을 받아 틈이 생기지 않는다.
    //
    // ponytail: 스키닝 후 경계를 매 프레임 다시 계산해 올리면 컬링을 되살릴 수 있다.
    bool skinned = instance.jointOffset != NO_JOINTS;
    bool useNetwork = (cull.flags & CULL_FLAG_NEURAL_LOD) != 0u;
    LodNetwork network = cull.network.item;
    mat3 normalMatrix = mat3(instance.normalMatrix);

    for (uint i = gl_LocalInvocationIndex; i < mesh.meshletCount; i += gl_WorkGroupSize.x) {
        Meshlet meshlet = cull.meshlets.items[mesh.meshletOffset + i];

        if (!selectLod(meshlet,
                       instance.model,
                       camera.position.xyz,
                       camera.parameters.y,
                       camera.parameters.z,
                       camera.parameters.w,
                       useNetwork,
                       network)) {
            continue;
        }

        vec4 sphere = transformBoundingSphere(instance.model, meshlet.boundingSphere);
        if (!skinned && (cull.flags & CULL_FLAG_FRUSTUM) != 0u && !sphereInFrustum(planes, sphere.xyz, sphere.w)) {
            continue;
        }
        if (!skinned && (cull.flags & CULL_FLAG_CONE) != 0u) {
            vec3 coneAxis = normalize(normalMatrix * meshlet.cone.xyz);
            if (!coneVisible(sphere.xyz, sphere.w, coneAxis, meshlet.cone.w, camera.position.xyz)) {
                continue;
            }
        }

        if (!skinned && (cull.flags & CULL_FLAG_OCCLUSION) != 0u &&
            occludedByHzb(camera.viewProjection, sphere, cull.hzbTexture, cull.hzbSize, cull.hzbMaxLevel)) {
            continue;
        }

        uint slot = atomicAdd(cull.drawCounts.items[instance.bucket], 1);
        DrawCommand command;
        command.indexCount = meshlet.triangleCount * 3;
        command.instanceCount = 1;
        command.firstIndex = meshlet.indexOffset;
        command.vertexOffset = mesh.vertexOffset;
        command.firstInstance = instanceIndex;
        cull.drawCommands.items[instance.bucketBase + slot] = command;
    }
}
