#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

#include "culling.glsl"
#include "scene_types.glsl"

// 워크그룹 하나가 인스턴스 하나를 맡고, 그 인스턴스의 meshlet 을 나누어 검사한다.
layout(local_size_x = 64) in;

layout(push_constant) uniform CullPushConstants {
    InstanceBuffer instances;
    MeshBuffer meshes;
    MeshletBuffer meshlets;
    CameraBuffer camera;
    DrawCommandBuffer drawCommands;
    CounterBuffer drawCounts;
    uint instanceCount;
    uint flags; // bit 0: 절두체, bit 1: 법선 원뿔, bit 3: 신경망 LOD
    // culling.glsl 의 CULL_PHASE_*. 오클루전 컬링은 두 패스로만 돈다.
    uint phase;
    LodNetworkBuffer network;
    // 스킨 인스턴스의 meshlet 경계 구. 변형 정점에서 프레임마다 다시 잰 것이다.
    SkinnedBoundsBuffer skinnedBounds;
    VisibilityBuffer visibility;
} cull;

#define CULL_FLAG_FRUSTUM 1u
#define CULL_FLAG_CONE 2u
#define CULL_FLAG_NEURAL_LOD 8u

void main() {
    uint instanceIndex = gl_WorkGroupID.x;
    if (instanceIndex >= cull.instanceCount) {
        return;
    }

    Instance instance = cull.instances.items[instanceIndex];
    Mesh mesh = cull.meshes.items[instance.meshIndex];
    Camera camera = cull.camera.item;

    vec4 planes[5];
    extractFrustumPlanes(camera.viewProjection, planes);

    // 스킨 인스턴스는 경계 구를 변형 정점에서 다시 잰 것으로 바꿔 절두체와 오클루전을 검사한다.
    // 법선 원뿔은 바인드 포즈 기준이라 스킨에서는 건너뛴다. LOD 선정은 오차 구의 상대 크기만
    // 쓰므로 그대로 두어도 같은 그룹이 같은 판정을 받아 틈이 생기지 않는다.
    bool skinned = instance.skinnedVertexOffset != NO_SKINNED_VERTICES;
    bool useNetwork = (cull.flags & CULL_FLAG_NEURAL_LOD) != 0u;
    LodNetwork network = cull.network.item;
    mat3 normalMatrix = mat3(instance.normalMatrix);

    for (uint i = gl_LocalInvocationIndex; i < mesh.meshletCount; i += gl_WorkGroupSize.x) {
        Meshlet meshlet = cull.meshlets.items[mesh.meshletOffset + i];

        // 2차 패스는 후보에서 떨어진 meshlet 의 비트도 지워야 하므로 판정을 끝까지 모아 한 번에 넘긴다.
        bool candidate = selectLod(meshlet,
                                   instance.model,
                                   camera.position.xyz,
                                   camera.parameters.y,
                                   camera.parameters.z,
                                   camera.parameters.w,
                                   useNetwork,
                                   network);
        vec4 localSphere =
            skinned ? cull.skinnedBounds.items[instance.skinnedMeshletOffset + i] : meshlet.boundingSphere;
        vec4 sphere = transformBoundingSphere(instance.model, localSphere);
        if ((cull.flags & CULL_FLAG_FRUSTUM) != 0u && !sphereInFrustum(planes, sphere.xyz, sphere.w)) {
            candidate = false;
        }
        if (candidate && !skinned && (cull.flags & CULL_FLAG_CONE) != 0u) {
            vec3 coneAxis = normalize(normalMatrix * meshlet.cone.xyz);
            candidate = coneVisible(sphere.xyz, sphere.w, coneAxis, meshlet.cone.w, camera.position.xyz);
        }
        if (!twoPhaseVisible(cull.phase, cull.visibility, instance.visibilityBase + i, candidate, camera, sphere)) {
            continue;
        }

        uint slot = atomicAdd(cull.drawCounts.items[instance.bucket], 1);
        DrawCommand command;
        command.indexCount = meshlet.triangleCount * 3;
        command.instanceCount = 1;
        command.firstIndex = meshlet.indexOffset;
        command.vertexOffset = mesh.vertexOffset;
        command.firstInstance = instanceIndex;
        cull.drawCommands.items[instance.bucketBase + slot] = command;
    }
}
