#version 460
#extension GL_EXT_mesh_shader : require

#include "meshlet_task.glsl"
#include "scene_data.glsl"

layout(local_size_x = MESHLET_GROUP_SIZE) in;
layout(triangles, max_vertices = 64, max_primitives = 124) out;

taskPayloadSharedEXT TaskPayload payload;

layout(location = 0) out vec3 outWorldPosition[];
layout(location = 1) out vec3 outNormal[];
layout(location = 2) out vec4 outTangent[];
layout(location = 3) out vec2 outUv[];
layout(location = 4) flat out uint outMaterialIndex[];
layout(location = 5) flat out uint outMeshletIndex[];
layout(location = 6) out vec4 outCurrentClip[];
layout(location = 7) out vec4 outPreviousClip[];

void main() {
    uint meshletIndex = payload.meshletIndices[gl_WorkGroupID.x];
    Meshlet meshlet = pushConstants.meshlets.items[meshletIndex];
    Instance instance = pushConstants.instances.items[payload.instanceIndex];
    Mesh mesh = pushConstants.meshes.items[instance.meshIndex];

    SetMeshOutputsEXT(meshlet.vertexCount, meshlet.triangleCount);

    mat3 normalMatrix = mat3(instance.normalMatrix);
    for (uint i = gl_LocalInvocationIndex; i < meshlet.vertexCount; i += MESHLET_GROUP_SIZE) {
        uint globalIndex = pushConstants.meshletVertices.items[meshlet.vertexOffset + i];
        Vertex vertex = fetchVertex(instance, mesh, globalIndex);
        vec4 worldPosition = instance.model * vec4(vertex.position, 1.0);

        // mesh shader 는 출력 변수를 되읽을 수 없어 클립 좌표를 지역 변수에 먼저 담는다.
        vec4 clipPosition = pushConstants.camera.item.viewProjection * worldPosition;
        gl_MeshVerticesEXT[i].gl_Position = clipPosition;
        outCurrentClip[i] = clipPosition;
        outPreviousClip[i] = previousClipPosition(instance, mesh, globalIndex, vertex.position);
        outWorldPosition[i] = worldPosition.xyz;
        vec4 tangent = decodeTangent(vertex.tangent);
        outNormal[i] = normalMatrix * decodeUnitVector(vertex.normal);
        outTangent[i] = vec4(normalMatrix * tangent.xyz, tangent.w);
        outUv[i] = vertex.uv;
        outMaterialIndex[i] = mesh.materialIndex;
        outMeshletIndex[i] = meshletIndex;
    }

    for (uint i = gl_LocalInvocationIndex; i < meshlet.triangleCount; i += MESHLET_GROUP_SIZE) {
        uint base = meshlet.triangleOffset + i * 3;
        gl_PrimitiveTriangleIndicesEXT[i] = uvec3(meshletTriangleIndex(pushConstants.meshletTriangles, base),
                                                  meshletTriangleIndex(pushConstants.meshletTriangles, base + 1),
                                                  meshletTriangleIndex(pushConstants.meshletTriangles, base + 2));
    }
}
