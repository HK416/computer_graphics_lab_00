#version 460

#include "rigid_common.glsl"

// 남은 침투를 위치로 밀어낸다. 속도는 건드리지 않으므로 쉬는 물체가 떨지 않는다. 질량 역수 비율로
// 나눠 무거운 쪽이 덜 밀린다. CPU 솔버의 마지막 단계와 같다.
layout(local_size_x = 64) in;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= push.bodyCount) {
        return;
    }
    RigidBody self = push.bodiesIn.items[i];
    if (!rigidDynamic(self)) {
        push.bodiesOut.items[i] = self;
        return;
    }

    vec3 correction = vec3(0.0);
    for (uint j = 0u; j < push.bodyCount; ++j) {
        if (j == i) {
            continue;
        }
        RigidBody other = push.bodiesIn.items[j];
        if (other.shape != RIGID_SHAPE_PLANE) {
            vec3 delta = other.position.xyz - self.position.xyz;
            float reach = self.angularVelocity.w + other.angularVelocity.w;
            if (dot(delta, delta) > reach * reach) {
                continue;
            }
        }
        RigidManifold manifold;
        if (self.shape == RIGID_SHAPE_SPHERE || other.shape != RIGID_SHAPE_SPHERE) {
            manifold = rigidCollide(self, other);
        } else {
            manifold = rigidCollide(other, self);
            manifold.normal = -manifold.normal;
        }
        float totalInverseMass = self.position.w + other.position.w;
        if (manifold.count == 0 || totalInverseMass <= 0.0) {
            continue;
        }
        // 중심이 겹치면 법선이 대칭이 되어 둘 다 같은 쪽으로 밀린다. rigid_solve.comp 와 같은 규칙으로
        // 번호를 보고 갈라 준다.
        vec3 between = other.position.xyz - self.position.xyz;
        if (dot(between, between) < 1.0e-12) {
            manifold.normal = i < j ? vec3(0.0, 1.0, 0.0) : vec3(0.0, -1.0, 0.0);
        }
        // 같은 짝의 여러 점은 가장 깊은 것 하나로 민다. 네 점을 다 밀면 네 배로 튀어 오른다.
        float deepest = 0.0;
        for (int c = 0; c < manifold.count; ++c) {
            deepest = max(deepest, manifold.depths[c]);
        }
        float depth = deepest - push.penetrationSlop;
        if (depth <= 0.0) {
            continue;
        }
        correction -= manifold.normal * (push.positionCorrection * depth / totalInverseMass) * self.position.w;
    }

    self.position.xyz += correction;
    push.bodiesOut.items[i] = self;
}
