#version 460

#include "rigid_common.glsl"

// Jacobi 한 반복. 물체마다 이웃 후보(해시 격자, rigidGatherNeighbors)와의 접촉을 지금 속도로 풀어 한 번에
// 더한다. 읽는 배열과 쓰는 배열이 달라 순서 의존이 없다.
layout(local_size_x = 64) in;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= push.bodyCount) {
        return;
    }
    RigidBody self = push.bodiesIn.items[i];
    // 평면과 운동학 물체는 밀리지 않는다.
    if (!rigidDynamic(self)) {
        push.bodiesOut.items[i] = self;
        return;
    }

    mat3 inertiaSelf = worldInverseInertia(self);
    vec3 deltaLinear = vec3(0.0);
    vec3 deltaAngular = vec3(0.0);

    uint neighbors[RIGID_MAX_NEIGHBORS];
    uint neighborCount = rigidGatherNeighbors(i, self.position.xyz, self.angularVelocity.w, neighbors);
    for (uint n = 0u; n < neighborCount; ++n) {
        uint j = neighbors[n];
        RigidBody other = push.bodiesIn.items[j];

        RigidManifold manifold = rigidCollide(self, other);
        if (manifold.count == 0) {
            continue;
        }
        // 중심이 정확히 겹치면 접촉 법선을 정할 근거가 없어 두 물체가 «같은» 방향을 고른다. 한 접촉을
        // 나눠 쓰는 CPU 와 달리 여기서는 물체마다 따로 만들기 때문이다. 그대로 두면 겹친 짝이 분리되지
        // 않고 통째로 한쪽으로 가속한다. 번호로 갈라 서로 반대쪽으로 민다.
        vec3 between = other.position.xyz - self.position.xyz;
        if (dot(between, between) < 1.0e-12) {
            manifold = overrideNormal(manifold, i < j ? vec3(0.0, 1.0, 0.0) : vec3(0.0, -1.0, 0.0));
        }

        float totalInverseMass = self.position.w + other.position.w;
        if (totalInverseMass <= 0.0) {
            continue;
        }
        mat3 inertiaOther = worldInverseInertia(other);
        float restitution = min(self.inverseInertia.w, other.inverseInertia.w);
        float friction = sqrt(self.halfExtents.w * other.halfExtents.w);
        // 접촉 점이 여럿이면 임펄스를 나눠 준다. 같은 면을 네 번 밀면 네 배로 튄다.
        float share = 1.0 / float(manifold.count);

        for (int c = 0; c < manifold.count; ++c) {
            vec3 point = manifold.points[c];
            vec3 normal = manifold.normals[c];
            vec3 armSelf = point - self.position.xyz;
            vec3 armOther = point - other.position.xyz;

            // 반발 목표는 반복 전 속도로 잰다.
            vec3 preSelf = self.preVelocity.xyz + cross(self.preAngularVelocity.xyz, armSelf);
            vec3 preOther = other.preVelocity.xyz + cross(other.preAngularVelocity.xyz, armOther);
            float preClosing = dot(preOther - preSelf, normal);
            float restitutionTarget = preClosing < -push.restitutionThreshold ? -restitution * preClosing : 0.0;

            vec3 velocitySelf = self.velocity.xyz + cross(self.angularVelocity.xyz, armSelf);
            vec3 velocityOther = other.velocity.xyz + cross(other.angularVelocity.xyz, armOther);
            vec3 relative = velocityOther - velocitySelf;

            vec3 torqueSelf = cross(armSelf, normal);
            vec3 torqueOther = cross(armOther, normal);
            float angular = dot(torqueSelf, inertiaSelf * torqueSelf) + dot(torqueOther, inertiaOther * torqueOther);
            float effectiveMass = 1.0 / (totalInverseMass + angular);

            float closing = dot(relative, normal);
            float lambda = max(effectiveMass * (-closing + restitutionTarget), 0.0) * share;
            // 법선은 self 에서 other 를 향하므로 self 는 반대로 밀린다.
            deltaLinear -= normal * lambda * self.position.w;
            deltaAngular -= inertiaSelf * cross(armSelf, normal * lambda);

            // 마찰. 접선 속도를 줄이되 쿨롱 원뿔 안에서만.
            //
            // 원뿔의 한계는 «이번 반복의 λ» 가 아니라 «이 스텝에 필요한 총 법선 임펄스» 로 잰다.
            // 반복이 거듭될수록 λ 는 0 으로 줄어드는데 그것으로 재면 첫 반복 뒤로 마찰이 사라진다.
            // 반복 전 속도로 재면 총량에 가깝다. 접선 임펄스 자체가 접선 속도에 비례해 줄어들므로
            // 한계가 넉넉해도 과하게 걸리지 않는다.
            // ponytail: CPU 는 실제로 쌓인 임펄스를 쓴다. 여기서는 어림값이라 수치가 완전히 같지 않다.
            float coneLambda = max(effectiveMass * (-preClosing + restitutionTarget), 0.0) * share;
            vec3 tangent = relative - normal * closing;
            float tangentSpeed = length(tangent);
            if (tangentSpeed > 1.0e-6) {
                tangent /= tangentSpeed;
                vec3 frictionTorqueSelf = cross(armSelf, tangent);
                vec3 frictionTorqueOther = cross(armOther, tangent);
                float frictionAngular = dot(frictionTorqueSelf, inertiaSelf * frictionTorqueSelf) +
                                        dot(frictionTorqueOther, inertiaOther * frictionTorqueOther);
                float frictionMass = 1.0 / (totalInverseMass + frictionAngular);
                float limit = friction * max(lambda, coneLambda);
                float tangentLambda = clamp(-frictionMass * tangentSpeed * share, -limit, limit);
                deltaLinear -= tangent * tangentLambda * self.position.w;
                deltaAngular -= inertiaSelf * cross(armSelf, tangent * tangentLambda);
            }
        }
    }

    self.velocity.xyz += deltaLinear;
    self.angularVelocity.xyz += deltaAngular;
    push.bodiesOut.items[i] = self;
}
