#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

#include "bindless.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform BlurPushConstants {
    uint sourceTexture;
    uint destinationStorage;
    ivec2 size;
}
blur;

// SSAO 는 표본 잡음이 많아 4x4 상자 흐림 한 번으로 충분히 매끈해진다.
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= blur.size.x || pixel.y >= blur.size.y) {
        return;
    }

    vec2 texel = 1.0 / vec2(blur.size);
    float total = 0.0;
    for (int y = -2; y <= 1; ++y) {
        for (int x = -2; x <= 1; ++x) {
            vec2 uv = (vec2(pixel) + 0.5 + vec2(x, y)) * texel;
            total += sampleBindless(blur.sourceTexture, clamp(uv, vec2(0.0), vec2(1.0))).r;
        }
    }
    imageStore(bindlessStorageImages[nonuniformEXT(blur.destinationStorage)], pixel, vec4(total / 16.0));
}
