#version 460
#extension GL_EXT_mesh_shader : require

#include "culling.glsl"
#include "meshlet_task.glsl"
#include "scene_data.glsl"

layout(local_size_x = MESHLET_GROUP_SIZE) in;

taskPayloadSharedEXT TaskPayload payload;
shared uint visibleCount;

void main() {
    MeshletGroup group = pushConstants.meshletGroups.items[pushConstants.meshletGroupBase + gl_WorkGroupID.x];

    if (gl_LocalInvocationIndex == 0) {
        visibleCount = 0;
        payload.instanceIndex = group.instanceIndex;
    }
    barrier();

    uint local = gl_LocalInvocationIndex;
    if (local < group.meshletCount) {
        uint meshletIndex = group.firstMeshlet + local;
        Instance instance = pushConstants.instances.items[group.instanceIndex];
        Meshlet meshlet = pushConstants.meshlets.items[meshletIndex];
        Mesh mesh = pushConstants.meshes.items[instance.meshIndex];

        // 스킨 인스턴스는 변형 정점에서 다시 잰 경계 구를 쓴다. cull_meshlets.comp 와 같다.
        bool skinned = instance.skinnedVertexOffset != NO_SKINNED_VERTICES;
        vec4 localSphere = skinned ? pushConstants.skinnedBounds.items[instance.skinnedMeshletOffset +
                                                                        (meshletIndex - mesh.meshletOffset)]
                                   : meshlet.boundingSphere;
        vec4 sphere = transformBoundingSphere(instance.model, localSphere);
        vec3 coneAxis = normalize(mat3(instance.normalMatrix) * meshlet.cone.xyz);

        vec4 planes[5];
        extractFrustumPlanes(pushConstants.camera.item.viewProjection, planes);

        // 태스크 셰이더 경로에서는 아직 신경망 보정을 쓰지 않는다.
        LodNetwork emptyNetwork;
        // 법선 원뿔은 바인드 포즈 기준이라 스킨 인스턴스는 원뿔 검사만 건너뛴다.
        Camera camera = pushConstants.camera.item;
        bool candidate = selectLod(meshlet,
                                   instance.model,
                                   camera.position.xyz,
                                   camera.parameters.y,
                                   camera.parameters.z,
                                   camera.parameters.w,
                                   false,
                                   emptyNetwork) &&
                         sphereInFrustum(planes, sphere.xyz, sphere.w) &&
                         (skinned || coneVisible(sphere.xyz, sphere.w, coneAxis, meshlet.cone.w, camera.position.xyz));
        // 두 패스 오클루전. cull_meshlets.comp 와 같은 함수를 쓴다.
        bool visible = twoPhaseVisible(pushConstants.cullPhase,
                                       pushConstants.meshletVisibility,
                                       instance.visibilityBase + (meshletIndex - mesh.meshletOffset),
                                       candidate,
                                       camera,
                                       sphere);
        if (visible) {
            payload.meshletIndices[atomicAdd(visibleCount, 1)] = meshletIndex;
        }
    }
    barrier();

    // EmitMeshTasksEXT 는 워크그룹 전체가 균일하게 한 번만 호출해야 한다.
    EmitMeshTasksEXT(visibleCount, 1, 1);
}
