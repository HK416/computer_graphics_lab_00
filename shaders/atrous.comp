#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require

#include "bindless.glsl"
#include "exposure.glsl"
#include "scene_types.glsl"

// 깊이·노멀·휘도 가중 à-trous 한 반복. ReSTIR 직접광과 경로 추적 누적을 표시용으로 누른다. 가중은 reflect.comp 의
// 반사 필터와 같지만 시간 모멘트 없이 입력의 3×3 휘도 표준편차로 휘도 폭을 정한다. 보폭 1·2·4 로 세 번 불린다.
// 하늘(깊이 0)은 잡음이 없어 그대로 지난다.
layout(local_size_x = 8, local_size_y = 8) in;

// src/gfx/renderer_internal.h 의 AtrousPushConstants 와 배치가 같아야 한다.
layout(push_constant, scalar) uniform AtrousPushConstants {
    CameraBuffer camera;
    uint inputTexture;
    // rgba16 스토리지. 비트 0 이 켜지면 결과를 여기에 더하고(색상 버퍼) 아니면 덮어쓴다.
    uint outputStorage;
    uint normalTexture;
    uint depthTexture;
    uint step;
    uint flags;
    // 입력에 곱하는 배율. 경로 추적 누적은 표본 수의 역수다.
    float inputScale;
    // 휘도 가중 폭 = 이 값 × 3×3 표준편차.
    float luminanceSigma;
} push;

float clipDepth(mat4 viewProjection, vec3 position) {
    return (viewProjection * vec4(position, 1.0)).w;
}

vec3 loadInput(vec2 uv) {
    return sampleBindless(push.inputTexture, uv).rgb * push.inputScale;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    Camera camera = push.camera.item;
    ivec2 size = ivec2(camera.viewport.xy);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }
    vec2 texel = 1.0 / vec2(size);
    vec2 uv = (vec2(pixel) + 0.5) * texel;
    vec3 center = loadInput(uv);
    vec3 result = center;
    float depth = sampleBindless(push.depthTexture, uv).r;
    int step = int(push.step);
    if (depth > 0.0) {
        float centerDepth = clipDepth(camera.viewProjection, worldFromDepth(camera, uv, depth));
        vec3 centerNormal = normalize(sampleBindless(push.normalTexture, uv).xyz);
        float centerLuminance = luminance(center);

        float sum = 0.0;
        float sumSquared = 0.0;
        for (int y = -1; y <= 1; ++y) {
            for (int x = -1; x <= 1; ++x) {
                float l = luminance(loadInput(clamp(uv + vec2(x, y) * texel * float(step), vec2(0.0), vec2(1.0))));
                sum += l;
                sumSquared += l * l;
            }
        }
        float mean = sum / 9.0;
        float deviation = sqrt(max(sumSquared / 9.0 - mean * mean, 0.0));
        float luminanceScale = push.luminanceSigma * deviation + 1.0e-3;

        const float kernel[5] = float[5](1.0 / 16.0, 4.0 / 16.0, 6.0 / 16.0, 4.0 / 16.0, 1.0 / 16.0);
        vec3 sumColor = vec3(0.0);
        float sumWeight = 0.0;
        for (int y = -2; y <= 2; ++y) {
            for (int x = -2; x <= 2; ++x) {
                ivec2 tap = pixel + ivec2(x, y) * step;
                if (any(lessThan(tap, ivec2(0))) || any(greaterThanEqual(tap, size))) {
                    continue;
                }
                vec2 tapUv = (vec2(tap) + 0.5) * texel;
                float tapDepth = sampleBindless(push.depthTexture, tapUv).r;
                if (tapDepth <= 0.0) {
                    continue;
                }
                vec3 tapColor = loadInput(tapUv);
                float tapClip = clipDepth(camera.viewProjection, worldFromDepth(camera, tapUv, tapDepth));
                vec3 tapNormal = normalize(sampleBindless(push.normalTexture, tapUv).xyz);
                float depthWeight = exp(-abs(centerDepth - tapClip) / (0.02 * centerDepth + 1.0e-4));
                float normalWeight = pow(max(dot(centerNormal, tapNormal), 0.0), 128.0);
                float luminanceWeight = exp(-abs(centerLuminance - luminance(tapColor)) / luminanceScale);
                float w = kernel[x + 2] * kernel[y + 2] * depthWeight * normalWeight * luminanceWeight;
                sumColor += w * tapColor;
                sumWeight += w;
            }
        }
        if (sumWeight > 0.0) {
            result = sumColor / sumWeight;
        }
    }
    result = max(result, vec3(0.0));
    if ((push.flags & 1u) != 0u) {
        vec4 color = imageLoad(bindlessStorageImagesRgba16[nonuniformEXT(push.outputStorage)], pixel);
        color.rgb += result;
        imageStore(bindlessStorageImagesRgba16[nonuniformEXT(push.outputStorage)], pixel, color);
    } else {
        imageStore(bindlessStorageImagesRgba16[nonuniformEXT(push.outputStorage)], pixel, vec4(result, 1.0));
    }
}
