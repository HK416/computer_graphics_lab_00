#version 460

#include "scene_types.glsl"

// 스킨 메쉬의 정점을 포즈 공간으로 옮겨 따로 뽑아 둔다. 래스터 경로는 정점 셰이더에서 같은 일을
// 하지만, 광선 경로는 하위 가속 구조를 정점 버퍼로 세우므로 변형된 정점이 메모리에 실제로 있어야
// 한다. 오브젝트 하나가 디스패치 하나다.
layout(push_constant) uniform SkinPushConstants {
    VertexBuffer source;
    SkinnedVertexBuffer destination;
    JointBuffer joints;
    // 정점별 조인트와 가중치. 정점과 떨어져 있고 weightOffset 부터 이 메쉬 몫이다.
    SkinWeightBuffer weights;
    // 전역 정점 버퍼에서 이 메쉬가 시작하는 위치.
    uint sourceOffset;
    // 스킨 정점 버퍼에서 이 인스턴스가 차지하는 구간의 시작.
    uint destinationOffset;
    uint jointOffset;
    uint vertexCount;
    // 가중치가 없는 메쉬(NO_SKIN_WEIGHTS)면 정점을 그대로 복사한다.
    uint weightOffset;
}
pushConstants;

#define NO_SKIN_WEIGHTS 0xFFFFFFFFu

layout(local_size_x = 64) in;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pushConstants.vertexCount) {
        return;
    }

    Vertex vertex = pushConstants.source.items[pushConstants.sourceOffset + index];
    mat4 skin = mat4(1.0);
    if (pushConstants.weightOffset != NO_SKIN_WEIGHTS) {
        SkinWeight weight = pushConstants.weights.items[pushConstants.weightOffset + index];
        skin = skinMatrix(pushConstants.joints, pushConstants.jointOffset, weight.joints, weight.weights);
    }
    // 조인트 변환은 강체에 가까워 노멀과 탄젠트도 같은 회전 부분으로 돌린다. 접힌 속성은 풀어서
    // 돌리고 다시 접는다. 조인트 행렬에 비균등 스케일이 있으면 정규화가 길이만 바로잡는다.
    // 가중치가 전부 0 인 정점은 행렬이 0 이라 normalize 가 NaN 을 내므로 길이 0 은 그대로 넘긴다.
    // encodeUnitVector 가 길이 0 을 +Z 로 접는다.
    mat3 rotation = mat3(skin);
    vec4 tangent = decodeTangent(vertex.tangent);
    vertex.position = (skin * vec4(vertex.position, 1.0)).xyz;
    vec3 normal = rotation * decodeUnitVector(vertex.normal);
    vec3 tangentAxis = rotation * tangent.xyz;
    vertex.normal = encodeUnitVector(dot(normal, normal) > 0.0 ? normalize(normal) : normal);
    vertex.tangent = encodeTangent(vec4(dot(tangentAxis, tangentAxis) > 0.0 ? normalize(tangentAxis) : tangentAxis,
                                        tangent.w));

    pushConstants.destination.items[pushConstants.destinationOffset + index] = vertex;
}
