#version 460
#extension GL_EXT_nonuniform_qualifier : require

#include "bindless.glsl"
#include "fog.glsl"
#include "lighting.glsl"
#include "pathtrace_common.glsl"

layout(set = 1, binding = 0) uniform accelerationStructureEXT topLevel;

layout(location = 0) rayPayloadEXT PathPayload payload;
// 그림자 광선은 페이로드를 따로 써야 표면 정보를 잃지 않고 경로를 이어 갈 수 있다.
layout(location = 1) rayPayloadEXT float shadowVisibility;

// 래스터 경로와 같은 환경 큐브맵을 읽는다. 두 경로가 같은 배경을 봐야 결과를 견줄 수 있다.
// 환경이 없으면(굽기 전) 예전 그라디언트로 되돌아간다.
const vec3 SKY_ZENITH = vec3(0.35, 0.45, 0.7);
const vec3 SKY_HORIZON = vec3(0.7, 0.75, 0.85);

vec3 skyRadiance(vec3 direction) {
    uvec4 environment = pathTrace.camera.item.environment;
    if (environment.w == 0u) {
        return mix(SKY_HORIZON, SKY_ZENITH, clamp(direction.y * 0.5 + 0.5, 0.0, 1.0)) * pathTrace.skyIntensity;
    }
    return sampleBindlessCube(pathTrace.camera.item.shading.w, direction).rgb * pathTrace.skyIntensity;
}

// 단면 재질은 후면을 컬링해 래스터와 같은 면만 보이게 한다. 아웃라인을 부풀린 껍데기로 넣은
// 모델은 이게 없으면 껍데기가 본체를 통째로 덮는다. 반투명과 컷오프 재질은 가속 구조에 OPAQUE 로
// 올리지 않았으므로 적중 셰이더가 알파를 보고 통과 여부를 정한다.
const uint PATH_RAY_FLAGS = gl_RayFlagsCullBackFacingTrianglesEXT;

// 화면 UV 단위 모션 벡터. mesh_shading.glsl 의 motionVector 와 같은 규약(지난 - 이번)이다.
vec2 screenVelocity(vec3 worldPosition, vec3 previousWorldPosition) {
    Camera camera = pathTrace.camera.item;
    vec4 currentClip = camera.viewProjection * vec4(worldPosition, 1.0);
    vec4 previousClip = camera.previousViewProjection * vec4(previousWorldPosition, 1.0);
    if (currentClip.w <= 0.0 || previousClip.w <= 0.0) {
        return vec2(0.0);
    }
    vec2 current = currentClip.xy / currentClip.w - camera.jitter.xy;
    return (previousClip.xy / previousClip.w - current) * 0.5;
}

// 하늘은 방향 벡터를 지난 시점으로 되쏘아 카메라 회전분만 담는다. sky.frag 와 같은 식이다.
vec2 skyVelocity(vec3 direction) {
    Camera camera = pathTrace.camera.item;
    vec4 currentClip = camera.viewProjection * vec4(camera.position.xyz + direction, 1.0);
    vec4 previousClip = camera.previousViewProjection * vec4(direction, 0.0);
    if (currentClip.w <= 0.0 || previousClip.w <= 0.0) {
        return vec2(0.0);
    }
    vec2 current = currentClip.xy / currentClip.w - camera.jitter.xy;
    return (previousClip.xy / previousClip.w - current) * 0.5;
}

// 다음 사건 추정. 장면 조명 하나를 균등하게 골라 그림자 광선을 쏜다.
vec3 nextEventEstimation(Surface surface, inout uint seed) {
    uint lightCount = pathTrace.camera.item.shading.x;
    if (lightCount == 0u) {
        return vec3(0.0);
    }

    uint index = min(uint(randomFloat(seed) * float(lightCount)), lightCount - 1u);
    Light light = pathTrace.lights.items[index];

    vec3 lightDirection;
    float distanceToLight;
    vec3 radiance = sampleLightRadiance(light, surface.position, lightDirection, distanceToLight);
    if (radiance == vec3(0.0) || dot(surface.normal, lightDirection) <= 0.0) {
        return vec3(0.0);
    }

    shadowVisibility = 0.0;
    traceRayEXT(topLevel,
                PATH_RAY_FLAGS | gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
                0xFF,
                0,
                0,
                1,
                surface.position,
                1e-3,
                lightDirection,
                min(distanceToLight - 1e-3, 1e4),
                1);
    if (shadowVisibility <= 0.0) {
        return vec3(0.0);
    }
    // 균등하게 하나만 골랐으므로 개수를 곱해 되돌린다. BRDF 는 래스터 경로와 같은 것을 쓴다.
    return evaluateBrdf(surface, lightDirection, radiance) * float(lightCount);
}

// 첫 그림자 조명 하나만 보고 가시성을 잰다. 디버그 뷰 전용이며, 조명을 매 바운스 무작위로
// 고르는 다음 사건 추정과 달리 래스터의 DEBUG_MODE_SHADOW 와 같은 조명을 본다.
float firstLightVisibility(vec3 position, vec3 normal) {
    uint lightCount = pathTrace.camera.item.shading.x;
    for (uint i = 0; i < lightCount; ++i) {
        Light light = pathTrace.lights.items[i];
        if (light.rightShadow.w < 0.0) {
            continue;
        }
        vec3 lightDirection;
        float distanceToLight;
        vec3 radiance = sampleLightRadiance(light, position, lightDirection, distanceToLight);
        if (radiance == vec3(0.0) || dot(normal, lightDirection) <= 0.0) {
            return 0.0;
        }
        shadowVisibility = 0.0;
        traceRayEXT(topLevel,
                    PATH_RAY_FLAGS | gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
                    0xFF,
                    0,
                    0,
                    1,
                    position,
                    1e-3,
                    lightDirection,
                    min(distanceToLight - 1e-3, 1e4),
                    1);
        return shadowVisibility;
    }
    return -1.0;
}

// 다음 방향을 뽑고 그 방향의 BSDF 가중치(brdf * cos / pdf)를 돌려준다. 확산과 거울 반사 로브를
// 프레넬 비중으로 골라 둘 다 표본이 남게 한다.
vec3 sampleBsdf(Surface surface, inout uint seed, out vec3 direction) {
    vec3 f0 = mix(vec3(0.04), surface.albedo, surface.metallic);
    float specularWeight = max(max(f0.r, f0.g), f0.b);
    float diffuseWeight = (1.0 - surface.metallic) * max(max(surface.albedo.r, surface.albedo.g), surface.albedo.b);
    float specularProbability = clamp(specularWeight / max(specularWeight + diffuseWeight, 1e-4), 0.1, 0.9);

    if (randomFloat(seed) < specularProbability) {
        vec3 halfway = sampleGgxHalfVector(surface.normal, surface.roughness, seed);
        direction = reflect(-surface.view, halfway);
        float nDotL = dot(surface.normal, direction);
        if (nDotL <= 0.0) {
            return vec3(0.0);
        }
        float nDotV = max(dot(surface.normal, surface.view), 1e-4);
        float nDotH = max(dot(surface.normal, halfway), 1e-4);
        float vDotH = max(dot(surface.view, halfway), 1e-4);
        // D 로 반값 벡터를 뽑았으므로 D 와 4*vDotH 가 약분되어 F * G * vDotH / (nDotV * nDotH) 만 남는다.
        vec3 fresnel = fresnelSchlick(vDotH, f0);
        float geometry = geometrySmith(nDotV, nDotL, surface.roughness);
        return fresnel * geometry * vDotH / (nDotV * nDotH * specularProbability);
    }

    direction = sampleCosineHemisphere(surface.normal, seed);
    // 코사인 표본이라 pdf 의 cos/PI 가 확산 BRDF 와 약분된다.
    vec3 fresnel = fresnelSchlick(max(dot(surface.normal, direction), 0.0), f0);
    return (vec3(1.0) - fresnel) * (1.0 - surface.metallic) * surface.albedo / (1.0 - specularProbability);
}

vec3 tracePath(vec3 origin, vec3 direction, inout uint seed, out PrimaryHit primary) {
    vec3 radiance = vec3(0.0);
    vec3 throughput = vec3(1.0);
    primary.normal = vec3(0.0);
    primary.albedo = vec3(0.0);
    primary.uv = vec2(0.0);
    primary.roughness = 0.0;
    primary.metallic = 0.0;
    primary.ndcDepth = 0.0;
    primary.velocity = vec2(0.0);
    primary.hitDistance = -1.0;
    primary.visibility = -1.0;
    bool useNextEvent = (pathTrace.flags & PATH_FLAG_NEXT_EVENT) != 0u;
    bool useRoulette = (pathTrace.flags & PATH_FLAG_RUSSIAN_ROULETTE) != 0u;

    for (uint bounce = 0; bounce < pathTrace.maxBounces; ++bounce) {
        traceRayEXT(topLevel, PATH_RAY_FLAGS, 0xFF, 0, 0, 0, origin, 1e-3, direction, 1e4, 0);

        if (payload.missed) {
            radiance += throughput * skyRadiance(direction);
            if (bounce == 0u) {
                primary.velocity = skyVelocity(direction);
            }
            break;
        }

        // 그림자 광선이 페이로드를 건드리기 전에 표면 정보를 복사해 둔다.
        Surface surface;
        surface.position = payload.position;
        surface.normal = payload.normal;
        surface.view = -direction;
        surface.albedo = payload.albedo;
        surface.metallic = payload.metallic;
        surface.roughness = payload.roughness;
        radiance += throughput * payload.emissive;

        // 1차 히트만 건져 둔다. 다음 바운스가 페이로드를 덮어쓰기 때문이다.
        if (bounce == 0u) {
            primary.normal = payload.normal;
            primary.albedo = payload.albedo;
            primary.uv = payload.uv;
            primary.roughness = payload.roughness;
            primary.metallic = payload.metallic;
            primary.hitDistance = payload.hitDistance;
            vec4 clip = pathTrace.camera.item.viewProjection * vec4(payload.position, 1.0);
            primary.ndcDepth = clip.w > 0.0 ? clip.z / clip.w : 0.0;
            primary.velocity = screenVelocity(payload.position, payload.previousPosition);
            if (pathTrace.debugMode == DEBUG_MODE_SHADOW) {
                primary.visibility = firstLightVisibility(surface.position, surface.normal);
            }
        }

        if (useNextEvent) {
            radiance += throughput * nextEventEstimation(surface, seed);
        }

        vec3 nextDirection;
        vec3 weight = sampleBsdf(surface, seed, nextDirection);
        if (weight == vec3(0.0)) {
            break;
        }
        throughput *= weight;

        // 러시안 룰렛으로 어두운 경로를 일찍 끊되 편향이 없도록 살아남은 경로를 키운다.
        if (useRoulette && bounce > 0) {
            float survival = clamp(max(max(throughput.r, throughput.g), throughput.b), 0.05, 1.0);
            if (randomFloat(seed) > survival) {
                break;
            }
            throughput /= survival;
        }

        origin = surface.position;
        direction = nextDirection;
    }
    return radiance;
}

// mesh.frag 의 debugColor 와 같은 그림이 나오도록 맞춘다. 경로 추적에 없는 모드(meshlet, LOD,
// 캐스케이드, 모션 벡터)는 편집기가 고를 수 없게 막아 두었다.
vec3 debugColor(PrimaryHit primary) {
    switch (pathTrace.debugMode) {
    case DEBUG_MODE_NORMAL:
        return normalize(primary.normal) * 0.5 + 0.5;
    case DEBUG_MODE_UV:
        return vec3(fract(primary.uv), 0.0);
    case DEBUG_MODE_DEPTH:
        // 래스터는 시야 축 거리를 쓰지만 여기서는 광선 거리를 그대로 쓴다. 축 거리보다 크거나
        // 같아 화면 가장자리만 아주 조금 멀게 나온다.
        return vec3(primary.hitDistance / (primary.hitDistance + 10.0));
    case DEBUG_MODE_VELOCITY: {
        // 픽셀 단위 변위를 8 픽셀에서 포화시켜 본다. 정지 화면은 회색이다. mesh.frag 와 같다.
        vec2 pixels = primary.velocity * pathTrace.camera.item.viewport.xy / 8.0;
        return vec3(clamp(pixels * 0.5 + 0.5, 0.0, 1.0), 0.5);
    }
    case DEBUG_MODE_SHADOW:
        // 그림자를 만드는 조명이 없으면 자홍색으로 알린다. 래스터 경로와 같은 관례다.
        return primary.visibility < 0.0 ? vec3(1.0, 0.0, 1.0) : vec3(primary.visibility);
    default:
        return vec3(0.0);
    }
}

void main() {
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    vec2 size = vec2(gl_LaunchSizeEXT.xy);
    uint seed = pcgHash(uint(pixel.x) + uint(pixel.y) * gl_LaunchSizeEXT.x + pathTrace.frameIndex * 9781u);

    Camera camera = pathTrace.camera.item;
    uint samplesPerFrame = max(pathTrace.samplesPerFrame, 1u);
    vec3 radiance = vec3(0.0);
    PrimaryHit primary;

    for (uint sampleIndex = 0; sampleIndex < samplesPerFrame; ++sampleIndex) {
        // 픽셀 안에서 표본 위치를 흔들어 누적하면서 앤티에일리어싱이 된다. RR 은 자기가 기대하는
        // 지터 수열이 있으므로 그때는 렌더러가 넘긴 값을 쓴다. camera.jitter 는 NDC 평행이동이라
        // 화면 크기의 절반을 곱해 픽셀 오프셋으로 되돌린다.
        // RR 프레임은 렌더러가 지터를 투영 행렬에 이미 넣어 두었다. 여기서 또 흔들면 두 번 흔들린다.
        vec2 jitter = (pathTrace.flags & PATH_FLAG_WRITE_GUIDES) != 0u
                          ? vec2(0.5)
                          : vec2(randomFloat(seed), randomFloat(seed));
        vec2 ndc = ((vec2(pixel) + jitter) / size) * 2.0 - 1.0;

        vec4 nearPoint = camera.inverseViewProjection * vec4(ndc, 1.0, 1.0);
        vec4 farPoint = camera.inverseViewProjection * vec4(ndc, 0.5, 1.0);
        vec3 origin = nearPoint.xyz / nearPoint.w;
        vec3 direction = normalize(farPoint.xyz / farPoint.w - origin);

        // 반딧불이 표본이 누적을 오래 흔들지 않도록 잘라 낸다.
        vec3 pathRadiance = min(tracePath(origin, direction, seed, primary), vec3(pathTrace.radianceClamp));
        // 안개는 래스터와 같은 함수로 1차 구간에만 건다.
        //
        // ponytail: 2차 이후 바운스와 그림자 광선은 안개를 모른다. 간접광이 조금 밝게 나온다.
        // 광선은 근평면에서 출발하므로 래스터와 같은 카메라 기준 거리로 되돌린다.
        float nearOffset = length(origin - camera.position.xyz);
        float fogDistance = primary.hitDistance < 0.0 ? 1.0e30 : primary.hitDistance + nearOffset;
        radiance += applyFog(camera, pathRadiance, camera.position.xyz, direction, fogDistance);
    }
    radiance /= float(samplesPerFrame);

    // 디버그 뷰는 셰이딩 대신 중간 값을 그린다. 매 프레임 같은 값이 쌓이므로 톤 매핑이 표본 수로
    // 나눠도 그 값 그대로 남는다. 아무것도 못 맞힌 화소는 래스터 경로와 맞춰 하늘을 그대로 둔다.
    if (pathTrace.debugMode != DEBUG_MODE_SHADED && primary.hitDistance >= 0.0) {
        radiance = debugColor(primary);
    }

    // 누적만 하고 나눗셈은 톤 매핑 패스에서 한다. 표본 수가 0 이면 이전 값을 버린다.
    vec4 previous = imageLoad(bindlessStorageImagesRgba[nonuniformEXT(pathTrace.accumulationImage)], pixel);
    vec4 accumulated = pathTrace.sampleCount == 0 ? vec4(radiance, 1.0) : previous + vec4(radiance, 1.0);
    imageStore(bindlessStorageImagesRgba[nonuniformEXT(pathTrace.accumulationImage)], pixel, accumulated);

    // 래스터 경로가 불투명 패스에서 하는 일을 여기서 대신한다. 경로 추적 프레임은 그 패스를
    // 돌지 않아 지난 프레임 값이 그대로 남아 있었다.
    imageStore(bindlessStorageImagesRg16[nonuniformEXT(pathTrace.velocityImage)], pixel,
               vec4(primary.velocity, 0.0, 0.0));

    if ((pathTrace.flags & PATH_FLAG_WRITE_GUIDES) != 0u) {
        // 금속은 알베도가 그대로 반사색이 되고, 유전체는 F0 0.04 다. pbr.glsl 과 같은 분해다.
        vec3 diffuse = primary.albedo * (1.0 - primary.metallic);
        vec3 specular = mix(vec3(0.04), primary.albedo, primary.metallic);
        // 맞힌 것이 없으면 하늘이다. 안내 값은 비워 두고 깊이는 무한 원거리(reverse-Z 의 0)로 둔다.
        bool hit = primary.hitDistance >= 0.0;
        imageStore(bindlessStorageImagesRgba16[nonuniformEXT(lowSlot(pathTrace.guideAlbedoSlots))],
                   pixel,
                   vec4(hit ? diffuse : vec3(0.0), 1.0));
        imageStore(bindlessStorageImagesRgba16[nonuniformEXT(highSlot(pathTrace.guideAlbedoSlots))],
                   pixel,
                   vec4(hit ? specular : vec3(0.0), 1.0));
        imageStore(bindlessStorageImagesRgba16[nonuniformEXT(lowSlot(pathTrace.guideNormalRoughnessSlots))],
                   pixel,
                   vec4(hit ? normalize(primary.normal) : vec3(0.0), 0.0));
        imageStore(bindlessStorageImages[nonuniformEXT(highSlot(pathTrace.guideNormalRoughnessSlots))],
                   pixel,
                   vec4(hit ? primary.roughness : 1.0, 0.0, 0.0, 0.0));
        imageStore(bindlessStorageImages[nonuniformEXT(pathTrace.guideDepthSlot)],
                   pixel,
                   vec4(hit ? primary.ndcDepth : 0.0, 0.0, 0.0, 0.0));
    }
}
