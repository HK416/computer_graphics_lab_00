#version 460
#extension GL_EXT_nonuniform_qualifier : require

#include "bindless.glsl"

// 작은 밉을 3x3 텐트 필터로 키워 한 단계 큰 밉과 섞는다. 가장 작은 밉부터 0단계까지 올라오면
// 0단계에 모든 단계의 흐림이 겹친다. 더하지 않고 섞는 이유는 밝기 총량을 원본과 비슷하게 묶어
// 세기 슬라이더가 어느 값에서든 화면을 씻어 내지 않게 하기 위해서다(Unity 의 scatter 와 같다).
layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform BloomPushConstants {
    uint sourceTexture;
    uint destinationStorage;
    vec2 sourceTexelSize;
    ivec2 destinationSize;
    uint sampleCount;
    uint firstLevel;
} bloom;

vec3 fetch(vec2 uv) {
    return sampleBindless(bloom.sourceTexture, uv).rgb;
}

void main() {
    ivec2 destination = ivec2(gl_GlobalInvocationID.xy);
    if (destination.x >= bloom.destinationSize.x || destination.y >= bloom.destinationSize.y) {
        return;
    }
    vec2 uv = (vec2(destination) + 0.5) / vec2(bloom.destinationSize);
    vec2 texel = bloom.sourceTexelSize;

    vec3 result = fetch(uv + texel * vec2(-1.0, -1.0));
    result += fetch(uv + texel * vec2(0.0, -1.0)) * 2.0;
    result += fetch(uv + texel * vec2(1.0, -1.0));
    result += fetch(uv + texel * vec2(-1.0, 0.0)) * 2.0;
    result += fetch(uv) * 4.0;
    result += fetch(uv + texel * vec2(1.0, 0.0)) * 2.0;
    result += fetch(uv + texel * vec2(-1.0, 1.0));
    result += fetch(uv + texel * vec2(0.0, 1.0)) * 2.0;
    result += fetch(uv + texel * vec2(1.0, 1.0));
    result *= 1.0 / 16.0;

    const float scatter = 0.7;
    vec3 existing = imageLoad(bindlessStorageImagesRgba16[nonuniformEXT(bloom.destinationStorage)], destination).rgb;
    imageStore(bindlessStorageImagesRgba16[nonuniformEXT(bloom.destinationStorage)],
               destination,
               vec4(mix(existing, result, scatter), 1.0));
}
